rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isRoomMember(roomId) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.members;
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid;
    }

    match /rooms/{roomId} {
      allow create: if signedIn() && request.auth.uid in request.resource.data.members;
      allow read, update: if isRoomMember(roomId);

      match /messages/{messageId} {
        allow read, create: if isRoomMember(roomId);
        allow update, delete: if isRoomMember(roomId) && resource.data.senderId == request.auth.uid;
      }
    }
  }
}
